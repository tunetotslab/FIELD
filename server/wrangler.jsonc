{
	"name": "field-api",
	"main": "worker.mjs",
	"compatibility_date": "2026-09-01",
	"triggers": { "crons": ["*/5 * * * *"] },
	"vars": {
		"APP_ORIGIN": "https://tunetotslab.github.io",
		"APP_URL": "https://tunetotslab.github.io/FIELD/",
		"ADMIN_TELEGRAM_ID": "5232786567",
		"GROUPS_ENABLED": "true",
		"WORLD_ENABLED": "true",
		"NATIVE_AUTH_ENABLED": "true",
		"WORLD_TELEGRAM_CHAT": "@Fieldapp",
		"SUPPORT_EMAIL": "tunetotslab@gmail.com"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "field",
			"database_id": "8e614552-c89a-4792-8a4e-987a10d7d6d8",
			"remote": true
		}
	],
	"r2_buckets": [
		{
			"binding": "AUDIO",
			"bucket_name": "field-audio",
			"remote": true
		}
	]
}
